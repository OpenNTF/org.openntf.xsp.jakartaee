<?xml version="1.0" encoding="UTF-8"?>
<xp:view xmlns:xp="http://www.ibm.com/xsp/core" xmlns:xe="http://www.ibm.com/xsp/coreex">
	<!--  Used to test https://github.com/OpenNTF/org.openntf.xsp.jakartaee/issues/767 -->
	<xp:this.data>
		<!-- 		<xp:dominoDocument var="doc" formName="ELTest"/> -->

		<xe:objectData var="doc" createObject="#{javascript: new java.util.HashMap()}"></xe:objectData>
	</xp:this.data>

	<xp:checkBoxGroup value="#{ex:doc.schedule}" id="schedule" styleClass="checkBoxGroup">
		<xp:selectItems value="${javascript:selectOptionsBean.getOptions()}"/>
		<xp:eventHandler event="onchange" submit="true" refreshMode="partial" refreshId="refresher"/> 
	</xp:checkBoxGroup>
		
	<xp:div id="refresher">
		<xp:text styleClass="schedule-output" value="#{javascript:selectOptionsBean.toJson(doc.get('schedule'))}"/>
	</xp:div>
	
	<xp:button id="submit" value="Save"><xp:eventHandler event="onclick" submit="true" refreshMode="complete" immediate="false" save="true"></xp:eventHandler></xp:button>
</xp:view>
