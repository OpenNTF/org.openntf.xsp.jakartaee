 jakarta.servlet.annotation;version="[6.1.0,7.0.0)",
 jakarta.servlet.http;version="[6.1.0,7.0.0)",
 javassist;version="[3.18.0,4.0.0]",
 org.glassfish.hk2.osgiresourcelocator,
 org.openntf.xsp.jakarta.cdi.discovery;version="3.8.0",
 org.openntf.xsp.jakarta.rest;version="3.8.0",
 org.openntf.xsp.jakarta.rest.exceptions;version="3.8.0",
 org.openntf.xsp.jakarta.rest.exceptions.handler;version="3.8.0",
 org.openntf.xsp.jakartaee.util;version="3.8.0",
 org.osgi.framework,
