 jakarta.enterprise.inject.spi;version="[4.1.0,5.0.0)",
 jakarta.ws.rs;version="[4.0.0,5.0.0)",
 jakarta.ws.rs.core;version="[4.0.0,5.0.0)",
 org.eclipse.microprofile.openapi.annotations;version="[1.2.0,2.0.0)",
 org.openntf.xsp.jakarta.cdi.discovery;version="3.8.0",
 org.openntf.xsp.jakarta.cdi.util;version="3.8.0",
 org.openntf.xsp.jakarta.rest;version="3.8.0",
 org.openntf.xsp.jakartaee.metrics;version="3.8.0",
 org.openntf.xsp.jakartaee.util;version="3.8.0",
