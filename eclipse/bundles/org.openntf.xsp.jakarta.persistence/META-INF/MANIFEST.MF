Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: XPages Jakarta Persistence Support
Bundle-SymbolicName: org.openntf.xsp.jakarta.persistence;singleton:=true
Automatic-Module-Name: org.openntf.xsp.jakarta.persistence
Bundle-ActivationPolicy: lazy
Bundle-Activator: org.openntf.xsp.jakarta.persistence.PersistenceActivator
Bundle-Version: 3.8.0.qualifier
Bundle-Vendor: OpenNTF
Bundle-RequiredExecutionEnvironment: JavaSE-17
Require-Bundle: jakarta.xml.bind-api;bundle-version="4.0.0";visibility:=reexport,
 jakarta.persistence-api;bundle-version="3.0.0";visibility:=reexport
Import-Package: org.eclipse.persistence.exceptions;version="[5.0.0,6.0.0)",
 org.eclipse.persistence.jpa;version="[5.0.0,6.0.0)",
 org.openntf.xsp.jakartaee.util;version="3.8.0",
 org.osgi.framework;version="1.8.0"
DynamicImport-Package: org.jboss.weld.*
Export-Package: org.openntf.xsp.jakarta.persistence;version="3.8.0"
