Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: XPages MicroProfile Config Support
Bundle-SymbolicName: org.openntf.xsp.microprofile.config;singleton:=true
Automatic-Module-Name: org.openntf.xsp.microprofile.config
Bundle-Version: 3.8.0.qualifier
Bundle-Vendor: OpenNTF
Bundle-RequiredExecutionEnvironment: JavaSE-17
Require-Bundle: org.openntf.org.eclipse.microprofile.config;bundle-version="3.0.0";visibility:=reexport
Import-Package: com.ibm.designer.runtime.domino.adapter,
 com.ibm.domino.napi,
 com.ibm.domino.napi.c,
 com.ibm.xsp.application,
 io.smallrye.config;version="[3.17.0,4.0.0)",
 io.smallrye.config.common;version="[3.17.0,4.0.0)",
 io.smallrye.config.inject;version="[3.17.0,4.0.0)",
 jakarta.annotation;version="[3.0.0,4.0.0)",
 jakarta.enterprise.inject.spi;version="[4.1.0,5.0.0)",
 jakarta.servlet;version="[6.1.0,7.0.0)",
 org.jboss.resteasy.plugins.interceptors;version="6.0.0",
 org.openntf.xsp.jakarta.cdi.discovery;version="3.8.0",
 org.openntf.xsp.jakarta.rest;version="3.8.0",
 org.openntf.xsp.jakartaee.events;version="3.8.0",
 org.openntf.xsp.jakartaee.module;version="3.8.0",
 org.openntf.xsp.jakartaee.module.jakarta;version="3.8.0",
 org.openntf.xsp.jakartaee.util;version="3.8.0"
Export-Package: org.openntf.xsp.microprofile.config;version="3.8.0",
 org.openntf.xsp.microprofile.config.ext;version="3.8.0"
Provide-Capability: osgi.serviceloader; osgi.serviceloader=org.eclipse.microprofile.config.spi.ConfigProviderResolver,
 osgi.contract; osgi.contract=JavaCDI; version:Version="2.0.0"
